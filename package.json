{
  "name": "saucedemo",
  "version": "1.0.0",
  "main": "cypress.config.js",
  "scripts": {
    "cypress:open": "cypress open --e2e --browser=electron",
    "cypress:run": "cypress run",
    "test": "cypress run",
    "test:cucumber": "cypress run --spec 'cypress/e2e/features/**/*.feature'",
    "test:cypress": "cypress run --spec 'cypress/e2e/features/**/*.cy.js'",
    "test:headed": "cypress run --headed"
  },
  "dependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.4",
    "cypress": "^14.5.3"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step_definitions/*.js",
    "html": {
      "enabled": true,
      "output": "cypress/reports/cucumber-report.html"
    },
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber-report.json"
    }
  }
}